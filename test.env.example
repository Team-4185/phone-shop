PORT=8080

DB_PORT=5500
DB_URL=jdbc:postgresql://localhost:5500/gadgetroom
DB_NAME=gadgetroom
DB_USERNAME=postgres
DB_PASSWORD=pass1234

JWT_PRIVATE_KEY=replace-with-private-key
JWT_PUBLIC_KEY=replace-with-public-key
JWT_RESET_SECRET=replace-with-at-least-32-bytes-secret
JWT_ACCESS_TOKEN_EXPIRATION=1h
JWT_REFRESH_TOKEN_EXPIRATION=7d
JWT_REMEMBER_ME_REFRESH_TOKEN_EXPIRATION=30d
JWT_RESET_TOKEN_EXPIRATION=10m

REDIS_PORT=6379

MINIO_URL=http://localhost:9000
MINIO_USERNAME=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_STORAGE_PORT=9000
MINIO_STORAGE_WEB_PORT=9001

FRONTEND_URL=http://localhost:5173

CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_MAX_CACHE_AGE=3600
CORS_ALLOW_CREDENTIALS=true

GMAIL_APP_PASSWORD=
GMAIL_USERNAME=

LOG_LEVEL=INFO
